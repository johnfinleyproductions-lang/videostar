{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "MiniMax H3 FL2VA fp8"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {
      "title": "Qwen3-VL 32B NVFP4 Encoder"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    },
    "_meta": {
      "title": "H3 Video VAE"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "_meta": {
      "title": "H3 Audio VAE"
    }
  },
  "5": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "",
      "width": 1344,
      "height": 768,
      "length": 124
    },
    "_meta": {
      "title": "FF H3 Video"
    }
  },
  "6": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["1", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    },
    "_meta": {
      "title": "Scheduler simple 20"
    }
  },
  "7": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "_meta": {
      "title": "Sampler res_multistep"
    }
  },
  "8": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["1", 0],
      "conditioning": ["5", 0]
    },
    "_meta": {
      "title": "Guider (no CFG)"
    }
  },
  "9": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    },
    "_meta": {
      "title": "FF Seed"
    }
  },
  "10": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["9", 0],
      "guider": ["8", 0],
      "sampler": ["7", 0],
      "sigmas": ["6", 0],
      "latent_image": ["5", 1]
    },
    "_meta": {
      "title": "FF Sampler S1"
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["3", 0]
    },
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "12": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["4", 0]
    },
    "_meta": {
      "title": "VAE Decode Audio"
    }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": 24,
      "audio": ["12", 0]
    },
    "_meta": {
      "title": "Create Video 24fps"
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "FrameForge/minimax_h3",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": {
      "title": "FF Output"
    }
  }
}
